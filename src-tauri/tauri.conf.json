{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Devi",
    "version": "0.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://**", "http://**"]
      },
      "shell": {
        "all": true,
        "open": true
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["$APP/*", "$DESKTOP/*", "$DOWNLOAD/*"]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.devi.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DrSkyle/devi-network/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNkI1QzIxMUNDOThCQzIKUldUQ2k4a2NJVnhyZ3lzKzRiemFzZXByTk9PcGYwL2gyYTRNMnB1ZGpGSW5pSmVDcVFGeFFQeTQK"
    },
    "windows": [
      {
        "title": "Devi",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}